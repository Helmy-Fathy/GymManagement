@model MemberViewModel
<div class="container">
    <main role="main" class="pb-3">


        <div class="container mt-5">
            <div class="row justify-content-center">
                <div class="col-md-6">
                    <div class="card card-details border-0 p-2 shadow">
                        <div class="text-center mt-3">
                            <img src="~/images/User.jpg" alt="MemberName" class="rounded-circle"
                                 style="width: 120px; height: 120px; object-fit: cover; border: 3px solid #fff; margin-top: -60px;" />
                        </div>
                        <div class="card-body text-center">
                            <h2 class="mb-1 text-primary-color">@Model.Name</h2>
                            <h4 class="mb-2 pb-1 border-bottom d-block">@(Model.PlanName?? "No Plan")</h4>
                            <div class="mt-4 text-start">
                                <div class="row g-3">
                                    <div class="col-12">
                                        <div class="p-3 bg-light rounded">
                                            <small class="text-muted d-block mb-1">@Model.Email</small>
                                            <strong>Salma@gmail.com</strong>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="p-3 bg-light rounded">
                                            <small class="text-muted d-block mb-1">@Model.Phone</small>
                                            <strong>01023652145</strong>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="p-3 bg-light rounded">
                                            <small class="text-muted d-block mb-1">@Model.Gender</small>
                                            <strong>Female</strong>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="p-3 bg-light rounded">
                                            <small class="text-muted d-block mb-1">@Model.DateOfBirth</small>
                                            <strong>07/25/2000</strong>
                                        </div>
                                    </div>

                                    <div class="col-6">
                                        <div class="p-3 bg-light rounded">
                                            <small class="text-muted d-block mb-1">@Model.MembershipStartDate</small>
                                            <strong>10/15/2025</strong>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="p-3 bg-light rounded">
                                            <small class="text-muted d-block mb-1">@Model.MembershipEndDate</small>
                                            <strong>12/15/2025</strong>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="p-3 bg-light rounded">
                                            <small class="text-muted d-block mb-1">@Model.Addres</small>
                                            <strong>2 - El Tahrir - Giza</strong>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between gap-2 px-3 pb-3">
                            <a asp-controller="Members" asp-action="Index" class="btn btn-fill flex-fill">Back to List</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </main>
</div>